# ============================================================
# Team Assistant Configuration
# ============================================================
# Скопируйте этот файл в .env и заполните значения

# ============ LLM Configuration ============
# Активный провайдер по умолчанию: deepseek | openai | gigachat
# Модель можно менять прямо в UI-селекторе — провайдер, ключ и base_url
# подставляются автоматически по префиксу id модели (deepseek/…, openai/…, gigachat/…).
LLM_PROVIDER=deepseek

# ---- DeepSeek (https://platform.deepseek.com/) ----
DEEPSEEK_API_KEY=sk-xxx
# Модели: deepseek-v4-pro, deepseek-v4-flash,
#   deepseek-chat / deepseek-reasoner (legacy, deprecated 2026/07/24)
DEEPSEEK_MODEL=deepseek-v4-pro
# Свой OpenAI-совместимый эндпоинт DeepSeek (опционально):
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Reasoning/thinking-режим по умолчанию:
DEEPSEEK_REASONING=false

# ---- OpenAI (https://platform.openai.com/) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Свой OpenAI-совместимый хостинг (Azure, прокси и т.п.), опционально:
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---- GigaChat (Сбер) ----
# GIGACHAT_CREDENTIALS — "Authorization key" (Base64 client_id:secret) из личного
# кабинета GigaChat. Access-токен получается и обновляется автоматически.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max
# Обычно менять не нужно:
# GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
# GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# GIGACHAT_VERIFY_SSL=false

# Список моделей для UI-селектора (JSON). Пусто = значение по умолчанию
# (DeepSeek + OpenAI + GigaChat). Можно переопределить под свои провайдеры:
# LLM_MODELS=[{"id":"gigachat/GigaChat-2-Max","name":"GigaChat 2 Max"},{"id":"openai/gpt-4o","name":"GPT-4o"}]

# Дефолтная модель для A2A / API запросов без явного выбора
# DEFAULT_MODEL=deepseek/deepseek-v4-pro

# ============ GitLab Configuration ============
# URL вашего GitLab сервера
GITLAB_URL=https://gitlab.example.com

# Personal Access Token (Settings -> Access Tokens)
# Scopes: read_api, read_repository
GITLAB_TOKEN=glpat-xxx

# Фильтр проектов (опционально, через запятую)
# Если не указан - доступны все проекты
GITLAB_PROJECTS=

# ============ YouGile Configuration ============
# URL YouGile (обычно https://ru.yougile.com)
YOUGILE_URL=https://ru.yougile.com

# API ключ (получить через API: /api-v2/auth/keys)
YOUGILE_API_KEY=xxx

# Фильтр проектов (опционально, через запятую)
YOUGILE_PROJECTS=

# ============ Outline Configuration ============
# URL Outline Wiki
OUTLINE_URL=https://outline.example.com

# API токен Outline (Settings -> API)
OUTLINE_API_TOKEN=ol_api_xxx

# ============ iCloud Configuration (Календарь + Напоминания) ============
# Доступ по кредам через CalDAV. Пустой ICLOUD_APP_PASSWORD => iCloud выключен.
# ICLOUD_USERNAME — ваш Apple ID (email).
# ICLOUD_APP_PASSWORD — пароль приложения: appleid.apple.com → Безопасность →
#   «Пароли приложений» → создать. Обычный пароль Apple ID при 2FA не подойдёт.
# Заметки (Apple Notes) недоступны с сервера — API у Apple нет; используйте
# напоминания с текстом в notes.
ICLOUD_USERNAME=
ICLOUD_APP_PASSWORD=
# Обычно менять не нужно:
# ICLOUD_CALDAV_URL=https://caldav.icloud.com
# Часовой пояс для событий/сроков без указания зоны:
ICLOUD_TIMEZONE=Europe/Moscow

# ============ Telegram Configuration ============
# API ID и Hash от my.telegram.org
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=xxx

# Номер телефона для авторизации
TELEGRAM_PHONE=+79991234567

# Разрешённые чаты (через запятую)
# Форматы: username, @username, chat_id, -100chatid
# Пример: @my_group,-1001234567890,my_team_chat
TELEGRAM_ALLOWED_CHATS=

# Путь для хранения сессии Telegram
TELEGRAM_SESSION_PATH=./data/sessions

# ============ Agent Configuration ============
# Максимум итераций агента
MAX_ITERATIONS=100

# Максимум сообщений в сессии
MAX_MESSAGES=50

# Лимиты контекста
MAX_CONTEXT_CHARS=200000
MAX_TOOL_RESULT_CHARS=100000

# ============ Server Configuration ============
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
