# Testing Rules

## Структура тестов

```
tests/
├── conftest.py           # Общие фикстуры
├── unit/
│   ├── test_services.py
│   └── test_utils.py
├── integration/
│   └── test_api.py
└── fixtures/
    ├── images/
    └── data.json
```

## Фикстуры (conftest.py)

```python
import pytest
from fastapi.testclient import TestClient
from sqlalchemy import create_engine
from sqlalchemy.orm import sessionmaker

from main import app
from database import Base, get_db

@pytest.fixture(scope="function")
def db_session():
    """Изолированная БД для каждого теста."""
    engine = create_engine("sqlite:///:memory:")
    Base.metadata.create_all(engine)
    Session = sessionmaker(bind=engine)
    session = Session()
    yield session
    session.close()

@pytest.fixture
def client(db_session):
    """Тестовый клиент с подменой зависимостей."""
    def override_get_db():
        yield db_session
    
    app.dependency_overrides[get_db] = override_get_db
    yield TestClient(app)
    app.dependency_overrides.clear()

@pytest.fixture
def sample_project(db_session):
    """Тестовый проект."""
    from models import Project
    project = Project(name="Test Project", description="For testing")
    db_session.add(project)
    db_session.commit()
    return project
```

## Паттерн AAA (Arrange-Act-Assert)

```python
def test_create_calibration_point_success(client, sample_calibration, sample_assay_line):
    # Arrange — подготовка
    point_data = {
        "signal": 125.5,
        "concentration": 50.0,
        "assay_line_id": str(sample_assay_line.id)
    }
    
    # Act — действие
    response = client.post(
        f"/api/calibrations/{sample_calibration.id}/points",
        json=point_data
    )
    
    # Assert — проверка
    assert response.status_code == 200
    data = response.json()
    assert data["signal"] == 125.5
    assert data["concentration"] == 50.0
    assert "id" in data
```

